DATABASE_URL="postgresql://tienda:cambiar-en-local@localhost:5232/tienda_dev"
# Solo en producción (Neon): DATABASE_URL = cadena con "-pooler"; DIRECT_URL = cadena directa, para migraciones
# DIRECT_URL=""

# Solo para la semilla (npx prisma db seed). Usa valores propios; mínimo 12 caracteres.
ADMIN_EMAIL="admin@ejemplo.local"
ADMIN_PASSWORD="cambiar-esta-clave"

# Almacenamiento de imágenes (Cloudinary). Si se dejan vacías, en desarrollo las imágenes
# se guardan en public/uploads. En producción son obligatorias.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# URL pública del sitio, sin / al final. En producción: el dominio del cliente con https://
# (si se omite en Vercel, se usa la URL que asigna Vercel)
SITE_URL="http://localhost:3000"
